<UserControl x:Class="FDTD2DLab.Views.ProbePlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <oxy:PlotView Model="{Binding PlotModel}" Grid.Row="0" MouseDoubleClick="PlotView_MouseDoubleClick"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="CSV" Command="{Binding ExportCsvCommand}" Margin="2"/>
            <Button Content="JSON" Command="{Binding ExportJsonCommand}" Margin="2"/>
        </StackPanel>
    </Grid>
</UserControl>
