<UserControl x:Class="FDTD2DLab.Views.SpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="http://schemas.fontawesome.com/icons/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:avalon="http://schemas.xceed.com/wpf/xaml/avalondock"
             xmlns:l="clr-namespace:FDTD2DLab"
             xmlns:svm="clr-namespace:FDTD2DLab.ViewModels.Shapes"
             xmlns:cvm="clr-namespace:FDTD2DLab.ViewModels.Source"
             xmlns:mvm="clr-namespace:FDTD2DLab.ViewModels.Material"
             xmlns:vm="clr-namespace:FDTD2DLab.ViewModels"
             xmlns:b="clr-namespace:FDTD2DLab.Infrastructure.Behaviors"
             xmlns:c="clr-namespace:FDTD2DLab.Infrastructure.Converters"
             xmlns:pvm="clr-namespace:FDTD2DLab.ViewModels.Probe"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:inf="clr-namespace:FDTD2DLab.Infrastructure"
             xmlns:sche="clr-namespace:FDTD2DLab.Infrastructure.Converters"
             xmlns:optvm ="clr-namespace:FDTD2DLab.ViewModels.Propertys"
             d:DesignHeight="450" d:DesignWidth="800"
             ><!--DataContext="{Binding MainWindowModel, Source={StaticResource Locator}}"-->
    <!--d:DesignHeight="450" d:DesignWidth="800"s
             Height="450" Width="800"-->
    <UserControl.Resources>
        <c:PercentOfContainerConverter x:Key="PercentOfContainer"/>
        <ObjectDataProvider x:Key="BoundaryTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:BoundaryType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <c:BooleanToVisibility x:Key="BooleanToVisibility"/>
        <DataTemplate x:Key="RectTemplate" DataType="{x:Type svm:RectViewModel}">
            <Grid Background="Transparent">
                <Rectangle Fill="DarkSlateGray"/>
                <Border BorderBrush="Red" BorderThickness="1" Margin="-2" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EllipseTemplate" DataType="{x:Type svm:EllipseViewModel}">
            <Grid Background="Transparent">
                <Ellipse Fill="Blue"/>
                <Border BorderBrush="Red" BorderThickness="1" Margin="-2" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PointSourceTemplate" DataType="{x:Type cvm:PointSourceViewModel}">
            <Ellipse Fill="Red" Stroke="DarkRed" StrokeThickness="1" ToolTip="{Binding Name}">
                <Ellipse.Width>
                    <MultiBinding Converter="{StaticResource PercentOfContainer}" ConverterParameter="0.05">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Border}"/>
                    </MultiBinding>
                </Ellipse.Width>
                <Ellipse.Height>
                    <MultiBinding Converter="{StaticResource PercentOfContainer}" ConverterParameter="0.05">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Border}"/>
                    </MultiBinding>
                </Ellipse.Height>
            </Ellipse>
        </DataTemplate>

        <DataTemplate x:Key="PlaneWaveTemplate" DataType="{x:Type cvm:PlaneWaveSourceViewModel}">
            <Grid Background="Transparent">
                <Rectangle Fill="Red" Stroke="DarkRed" StrokeThickness="1" ToolTip="{Binding Name}"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProbeTemplate" DataType="{x:Type pvm:ProbeViewModel}">
            <Ellipse Fill="Green" Stroke="DarkGreen" StrokeThickness="2" ToolTip="{Binding Name}"/>
        </DataTemplate>
        
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Column="1" Grid.Row="1" BorderThickness="0" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock>
                      Cell
                      <TextBlock Text="{Binding Grid.MousePositionCell.X, StringFormat=x:{0:f0}}" Width="50"/>
                      (<TextBlock Text="{Binding Grid.MousePosition.X, StringFormat={}{0:0.##}}"/>
                      <TextBlock Text="{Binding Grid.SpaceUnit}"/>)
                  </TextBlock>
                    <TextBlock>
                      Cell
                      <TextBlock Text="{Binding Grid.MousePositionCell.Y, StringFormat=y:{0:f0}}" Width="50"/>
                      (<TextBlock Text="{Binding Grid.MousePosition.Y, StringFormat={}{0:0.##}}"/>
                      <TextBlock Text="{Binding Grid.SpaceUnit}"/>)
                  </TextBlock>
                </StackPanel>
                
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="0">
            <ToolBarTray DockPanel.Dock="Top" Background="White" Grid.Column="0">
                <ToolBar Background="White">
                    <Button fa:Awesome.Content="Solid_Cut" ToolTip="Вырезать"/>
                    <Button fa:Awesome.Content="Solid_Copy" ToolTip="Копировать"/>
                    <Button fa:Awesome.Content="Solid_Paste" ToolTip="Вставить"/>
                    <Separator/>
                    <TextBlock VerticalAlignment="Center" Text="Объекты:"/>
                    <Button Width="16.5" Height="19" Command="{Binding Grid.AddRectShapeToGrid}" ToolTip="Прямоугольник" >
                        <Rectangle Fill="Blue" Width="8" Height="13" Stroke="DarkBlue" StrokeThickness="1"/>
                    </Button>
                    <Button Width="16.5" Height="19" Command="{Binding Grid.AddEllipseShapeToGrid}" ToolTip="Эллипс">
                        <Ellipse Fill="Blue" Width="8" Height="13" Stroke="DarkBlue" StrokeThickness="1"/>
                    </Button>
                    <Separator/>
                    <TextBlock VerticalAlignment="Center" Text="Источники:"/>
                    <Button Width="16.5" Height="19" ToolTip="Точечный" Command="{Binding Grid.AddPointSourceCommand}">
                        <Ellipse Fill="Red" Width="5" Height="5" Stroke="DarkRed" StrokeThickness="1"/>
                    </Button>
                    <Button Width="16.5" Height="19" ToolTip="Линия">
                        <Rectangle Fill="Red" Width="2" Height="13" />
                    </Button>
                    <Button Width="16.5" Height="19" ToolTip="Плоская падающая волна" Command="{Binding Grid.AddPlaneWaveSourceCommand}">
                        <Rectangle Width="9" Height="13" >
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent"/>
                                    <GradientStop Color="Red" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Button>
                    <Separator/>
                    <TextBlock VerticalAlignment="Center" Text="Зонд:"/>
                    <Button Width="16.5" Height="19" ToolTip="Зонд" Command="{Binding Grid.AddProbeCommand}">
                        <Ellipse Fill="Green" Width="5" Height="5" Stroke="DarkGreen" StrokeThickness="1"/>
                    </Button>
                    <Separator/>
                    <TextBlock VerticalAlignment="Center" Text="Моделирование:"/>
                    <Button Width="16.5" Height="19" ToolTip="Точечный">
                        <Ellipse Fill="Red" Width="5" Height="5" Stroke="DarkRed" StrokeThickness="1"/>
                    </Button>
                    <Button Width="16.5" Height="19" ToolTip="Точечный">
                        <Ellipse Fill="Red" Width="5" Height="5" Stroke="DarkRed" StrokeThickness="1"/>
                    </Button>
                    <Button Width="16.5" Height="19" ToolTip="Точечный">
                        <Ellipse Fill="Red" Width="5" Height="5" Stroke="DarkRed" StrokeThickness="1"/>
                    </Button>
                    <Button Width="16.5" Height="19" ToolTip="Точечный">
                        <Ellipse Fill="Red" Width="5" Height="5" Stroke="DarkRed" StrokeThickness="1"/>
                    </Button>
                    <Button Command="{Binding Grid.TestingCommand}">
                    Test    
                    </Button>
                </ToolBar>
            </ToolBarTray>
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border ClipToBounds="True" BorderThickness="1" BorderBrush="Black" Padding="1" Grid.Column="0"
        x:Name="DrawingArea">
                    <i:Interaction.Behaviors>
                        <b:MouseMove PositionRelative="{Binding Grid.GridMousePosition, Mode=OneWayToSource}"/>
                    </i:Interaction.Behaviors>
                    <Grid>
                        <Image Source="{Binding FieldBitmap}" 
                          Stretch="Fill" 
                          RenderOptions.BitmapScalingMode="NearestNeighbor"
                          Opacity="0.7"/>

                        <ItemsControl ItemsSource="{Binding Grid.GridX}">
                            <ItemsControl.Resources>
                                <c:Div x:Key="DivX" Parameter="{Binding Grid.Nx}"/>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0.25,0" BorderBrush="Gray"
                                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource DivX}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="inf:RelPos.MouseButtonDownCommand" Value="{Binding DataContext.Grid.SetShapeCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <ItemsControl  ItemsSource="{Binding Grid.GridY}">
                            <ItemsControl.Resources>
                                <c:Div x:Key="DivY" Parameter="{Binding Grid.Ny}"/>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,0.25" BorderBrush="Gray"
                                  Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource DivY}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Grid.Items}" Background="Transparent">
                            <ItemsControl.ItemTemplateSelector>
                                <b:ObjectTemplateSelector/>
                            </ItemsControl.ItemTemplateSelector>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>

                                <Style TargetType="ContentPresenter">
                                    <!-- Нет общих сеттеров – всё внутри триггеров -->

                                    <Style.Triggers>
                                        <!-- ========== ПРЯМОУГОЛЬНИК ========== -->
                                        <DataTrigger Binding="{Binding ShapeType}" Value="{x:Type svm:RectViewModel}">
                                            <Setter Property="b:DragDropBehavior.CanDrop" Value="True"/>
                                            <Setter Property="inf:RelPos.Binding" Value="True"/>
                                            <Setter Property="inf:RelPos.ContainerWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.ContainerHeight" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.MaxX" Value="{Binding DataContext.Grid.Lx, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.MaxY" Value="{Binding DataContext.Grid.Ly, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.X" Value="{Binding X}"/>
                                            <Setter Property="inf:RelPos.Y" Value="{Binding Y}"/>
                                            <Setter Property="inf:RelPos.ValueWidth" Value="{Binding Width}"/>
                                            <Setter Property="inf:RelPos.ValueHeight" Value="{Binding Height}"/>
                                            <Setter Property="inf:RelPos.MouseButtonDownCommand" Value="{Binding DataContext.Grid.SetShapeCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.MouseButtonUpCommand" Value="{Binding DataContext.Grid.UnSetShapeCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="{Binding Angle}"/>
                                                        <TranslateTransform X="{Binding Width}"
                                                        Y="{Binding Height}"/>
                                                    </TransformGroup>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <!-- ========== ЭЛЛИПС ========== -->
                                        <DataTrigger Binding="{Binding ShapeType}" Value="{x:Type svm:EllipseViewModel}">
                                            <Setter Property="b:DragDropBehavior.CanDrop" Value="True"/>
                                            <Setter Property="inf:RelPos.Binding" Value="True"/>
                                            <Setter Property="inf:RelPos.ContainerWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.ContainerHeight" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.MaxX" Value="{Binding DataContext.Grid.Lx, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.MaxY" Value="{Binding DataContext.Grid.Ly, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.X" Value="{Binding X}"/>
                                            <Setter Property="inf:RelPos.Y" Value="{Binding Y}"/>
                                            <Setter Property="inf:RelPos.ValueWidth" Value="{Binding Width}"/>
                                            <Setter Property="inf:RelPos.ValueHeight" Value="{Binding Height}"/>
                                            <Setter Property="inf:RelPos.MouseButtonDownCommand" Value="{Binding DataContext.Grid.SetShapeCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.MouseButtonUpCommand" Value="{Binding DataContext.Grid.UnSetShapeCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="{Binding Angle}"/>
                                                        <TranslateTransform X="{Binding Width}"
                                                        Y="{Binding Height}"/>
                                                    </TransformGroup>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <!-- ========== ТОЧЕЧНЫЙ ИСТОЧНИК ========== -->
                                        <DataTrigger Binding="{Binding SourceType}" Value="{x:Type cvm:PointSourceViewModel}">
                                            <Setter Property="inf:RelPos.Binding" Value="True"/>
                                            <Setter Property="inf:RelPos.CanResize" Value="False"/>
                                            <Setter Property="inf:RelPos.ValueWidth" Value="10"/>
                                            <Setter Property="inf:RelPos.ValueHeight" Value="10"/>
                                            <Setter Property="inf:RelPos.ContainerWidth" 
         Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.ContainerHeight" 
         Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.MaxX" 
         Value="{Binding DataContext.Grid.Lx, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.MaxY" 
         Value="{Binding DataContext.Grid.Ly, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.X" Value="{Binding X}"/>
                                            <Setter Property="inf:RelPos.Y" Value="{Binding Y}"/>
                                            <Setter Property="inf:RelPos.MouseButtonDownCommand" Value="{Binding DataContext.Grid.SetSourceCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.MouseButtonUpCommand" Value="{Binding DataContext.Grid.UnSetSourceCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </DataTrigger>

                                        <!-- ========== ПЛОСКАЯ ВОЛНА ========== -->
                                        <DataTrigger Binding="{Binding SourceType}" Value="{x:Type cvm:PlaneWaveSourceViewModel}">
                                            <Setter Property="inf:RelPos.Binding" Value="True"/>
                                            <Setter Property="inf:RelPos.CanResize" Value="False"/>
                                            <Setter Property="inf:RelPos.ValueWidth" Value="{Binding ValueWidth}"/>
                                            <Setter Property="inf:RelPos.ValueHeight" Value="{Binding ValueHeight}"/>
                                            <Setter Property="inf:RelPos.ContainerWidth" 
                                                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.ContainerHeight" 
                                                    Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.MaxX" 
                                                    Value="{Binding DataContext.Grid.Lx, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.MaxY" 
                                                    Value="{Binding DataContext.Grid.Ly, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.X" Value="{Binding X}"/>
                                            <Setter Property="inf:RelPos.Y" Value="{Binding Y}"/>
                                            <Setter Property="inf:RelPos.MouseButtonDownCommand" Value="{Binding DataContext.Grid.SetSourceCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.MouseButtonUpCommand" Value="{Binding DataContext.Grid.UnSetSourceCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </DataTrigger>

                                        <!-- ========== ЗОНД ========== -->
                                        <DataTrigger Binding="{Binding ProbeType}" Value="{x:Type pvm:ProbeViewModel}">
                                            <Setter Property="inf:RelPos.Binding" Value="True"/>
                                            <Setter Property="inf:RelPos.CanResize" Value="False"/>
                                            <Setter Property="inf:RelPos.ValueWidth" Value="{Binding ValueWidth}"/>
                                            <Setter Property="inf:RelPos.ValueHeight" Value="{Binding ValueWidth}"/>
                                            <Setter Property="inf:RelPos.ContainerWidth" 
                                                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.ContainerHeight" 
                                                    Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <Setter Property="inf:RelPos.MaxX" 
                                                    Value="{Binding DataContext.Grid.Lx, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.MaxY" 
                                                    Value="{Binding DataContext.Grid.Ly, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.X" Value="{Binding X}"/>
                                            <Setter Property="inf:RelPos.Y" Value="{Binding Y}"/>
                                            <Setter Property="inf:RelPos.MouseButtonDownCommand" 
                                                    Value="{Binding DataContext.Grid.SetProbeCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Setter Property="inf:RelPos.MouseButtonUpCommand" 
                                                    Value="{Binding DataContext.Grid.UnSetProbeCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                        </ItemsControl>

                       
                    </Grid>
                </Border>

                <TabControl Grid.Column="1" TabStripPlacement="Bottom" Margin="5,5,5,5">
                    <TabItem Header="параметры">
                        <ScrollViewer Grid.Column="1" DataContext="{Binding Grid}" VerticalScrollBarVisibility="Visible" Margin="3,3,3,3">
                            <StackPanel >
                                <StackPanel>
                                    <ContentControl Content="{Binding SelectedProperty}">
                                        <ContentControl.Resources>
                                            <DataTemplate DataType="{x:Type svm:EllipseViewModel}">
                                                <StackPanel Margin="1,2,1,1">
                                                    <TextBlock Text="ЭЛЛИПС" TextAlignment="Center" FontSize="15" FontFamily="Segoe UI Semibold"/>
                                                    <StackPanel  Grid.IsSharedSizeScope="True">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Margin" Value="0,1"></Setter>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                                                                    <ColumnDefinition/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}"
                                                                      Margin="0,0,3,0"
                                                                      HorizontalAlignment="Right" TextBlock.FontWeight="Bold"/>
                                                                                <Border Grid.Column="1" x:Name="border"
                                                                          Background="{TemplateBinding Background}"
                                                                          BorderThickness="{TemplateBinding BorderThickness}"
                                                                          BorderBrush="{TemplateBinding BorderBrush}"
                                                                          SnapsToDevicePixels="True">
                                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                           Focusable="False"
                                                                           HorizontalScrollBarVisibility="Hidden"
                                                                           VerticalScrollBarVisibility="Hidden"/>
                                                                                </Border>
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsEnabled" Value="False">
                                                                                    <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="BorderBrush" Value="Blue"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </StackPanel.Resources>

                                                        <TextBlock Text="Горизонтальное положение" TextAlignment="Left" Padding="30,1,1,1"/>
                                                        <TextBox Tag="x:" Text="{Binding X}" ToolTip="Горизонтальное положение"/>
                                                        <Rectangle Height="1" Fill="Gray" Margin="2,5,2,2"/>
                                                        <TextBlock Text="Расположение по y" TextAlignment="Left" Padding="30,1,1,1"/>
                                                        <TextBox Tag="y:" Text="{Binding Y}" ToolTip="Вертикальное положение"/>
                                                        <Rectangle Height="1" Fill="Gray" Margin="2,5,2,2"/>
                                                        <TextBlock Text="Горизонтальный размер" TextAlignment="Left" Padding="30,1,1,1"/>
                                                        <TextBox Tag="w:" Text="{Binding Width}" ToolTip="Ширина"/>
                                                        <Rectangle Height="1" Fill="Gray" Margin="2,5,2,2"/>
                                                        <TextBlock Text="Вертикальный размер" TextAlignment="Left" Padding="30,1,1,1"/>
                                                        <TextBox Tag="h:" Text="{Binding Height}" ToolTip="Высота"/>
                                                        <TextBlock Text="Угол поворота" TextAlignment="Left" Padding="30,1,1,1"/>
                                                        <TextBox Tag="ang:" Text="{Binding Angle}" ToolTip="Угол поворота"/>
                                                        <Rectangle Height="2" Fill="DarkCyan" Margin="2,5,2,2"/>

                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type svm:RectViewModel}">
                                                <StackPanel Margin="1,2,1,1">
                                                    <TextBlock Text="ПРЯМОУГОЛЬНИК" TextAlignment="Center" FontSize="15" FontFamily="Segoe UI Semibold"/>
                                                    <StackPanel  Grid.IsSharedSizeScope="True">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Margin" Value="0,1"></Setter>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                                                                    <ColumnDefinition/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}"
                                                                  Margin="0,0,3,0"
                                                                  HorizontalAlignment="Right" TextBlock.FontWeight="Bold"/>
                                                                                <Border Grid.Column="1" x:Name="border"
                                                                  Background="{TemplateBinding Background}"
                                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                                  SnapsToDevicePixels="True">
                                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Focusable="False"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollBarVisibility="Hidden"/>
                                                                                </Border>
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsEnabled" Value="False">
                                                                                    <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="BorderBrush" Value="Blue"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </StackPanel.Resources>

                                                        <TextBlock Text="Горизонтальное положение" TextAlignment="Left" Padding="30,1,1,1"/>
                                                        <TextBox Tag="x:" Text="{Binding X}" ToolTip="Горизонтальное положение"/>
                                                        <Rectangle Height="1" Fill="Gray" Margin="2,5,2,2"/>
                                                        <TextBlock Text="Расположение по y" TextAlignment="Left" Padding="30,1,1,1"/>
                                                        <TextBox Tag="y:" Text="{Binding Y}" ToolTip="Вертикальное положение"/>
                                                        <Rectangle Height="1" Fill="Gray" Margin="2,5,2,2"/>
                                                        <TextBlock Text="Горизонтальный размер" TextAlignment="Left" Padding="30,1,1,1"/>
