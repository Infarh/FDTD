                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" Margin="2"/>
                                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AppliedMaterial.Name}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ε:" Margin="2"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AppliedMaterial.Eps}"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="μ:" Margin="2"/>
                                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AppliedMaterial.Mu}"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="σ:" Margin="2"/>
                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AppliedMaterial.Sigma}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type mvm:MaterialViewModel}">
                                                <StackPanel Margin="1,2,1,1">
                                                    <TextBlock Text="Новый материал" FontWeight="Bold" Margin="0,5"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" Margin="2"/>
                                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ε:" Margin="2"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Eps}"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="μ:" Margin="2"/>
                                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Mu}"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="σ:" Margin="2"/>
                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Sigma}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type cvm:SourceViewModel}">
                                                <Separator/>
                                            </DataTemplate>
                                        </ContentControl.Resources>
                                    </ContentControl>
                                </StackPanel>
                            </StackPanel>

                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="сетка" DataContext="{Binding Grid}">
                        <ScrollViewer Style="{StaticResource ThinScrollViewer}">
                        <StackPanel>
                        <Grid Margin="5">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Grid.Column" Value="0">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,3,0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Margin" Value="0,1.5,1,1.5"/>
                                </Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Margin" Value="0,1.5,0,1.5"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Nx:" HorizontalAlignment="Right"/>
                            <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Nx}"/>

                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Ny:" HorizontalAlignment="Right"/>
                            <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Ny}"/>

                            <TextBlock Grid.Column="0" Grid.Row="2" Text="dx:" HorizontalAlignment="Right"/>
                            <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding dx}"/>
                            <ComboBox Grid.Column="2" Grid.Row="2"
                                  ItemsSource="{Binding SpaceUnits}" 
                                  SelectedItem="{Binding SpaceUnit}">
                                <ComboBox.ToolTip>
                                    <TextBlock Text="{Binding SpaceUnitValue, StringFormat={}{0} м}"/>
                                </ComboBox.ToolTip>
                            </ComboBox>

                            <TextBlock Grid.Column="0" Grid.Row="3" Text="dy:" HorizontalAlignment="Right"/>
                            <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding dy}"/>
                            <ComboBox Grid.Column="2" Grid.Row="3"
                                  ItemsSource="{Binding SpaceUnits}" 
                                  SelectedItem="{Binding SpaceUnit}">
                                <ComboBox.ToolTip>
                                    <TextBlock Text="{Binding SpaceUnitValue, StringFormat={}{0} м}"/>
                                </ComboBox.ToolTip>
                            </ComboBox>

                                <TextBlock Grid.Column="0" Grid.Row="4" Text="dt:" HorizontalAlignment="Right"/>
                                <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding dt}"/>

                                <TextBlock Grid.Column="0" Grid.Row="5" Text="Lx:" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="1" Grid.Row="5" Text="{Binding Lx}"/>
                            <TextBlock Grid.Column="2" Grid.Row="5" Text="{Binding SpaceUnit}" Margin="6,0,0,0"/>

                            
                        </Grid>
                        <Expander Header="Граничные условия" IsExpanded="True">
                            <StackPanel Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Левая (x=0):"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Source={StaticResource BoundaryTypes}}"
                                        SelectedItem="{Binding BoundaryLeft}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Правая (x=Lx):"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Source={StaticResource BoundaryTypes}}"
                                        SelectedItem="{Binding BoundaryRight}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Нижняя (y=0):"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Source={StaticResource BoundaryTypes}}"
                                        SelectedItem="{Binding BoundaryBottom}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Верхняя (y=Ly):"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Source={StaticResource BoundaryTypes}}"
                                        SelectedItem="{Binding BoundaryTop}"/>
                                </Grid>
                                <!-- Параметры PML -->
                                    <Expander Header="Параметры PML" IsExpanded="False" Visibility="{Binding ShowPmlSettings, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Толщина (ячейки):"/>
                                        <TextBox Text="{Binding PmlThickness}"/>
                                        <TextBlock Text="Проводимость (max):"/>
                                        <TextBox Text="{Binding PmlSigmaMax}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

            </Grid>

        </DockPanel>
    </Grid>
</UserControl>
