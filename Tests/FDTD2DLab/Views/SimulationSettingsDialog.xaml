<Window x:Class="FDTD2DLab.Views.SimulationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:FDTD2DLab.ViewModels"
        mc:Ignorable="d"
        Title="Настройки моделирования" Width="550" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Левая панель: параметры сетки -->
        <GroupBox Header="Параметры сетки" Grid.Column="0" Margin="5">
            <StackPanel>
                <TextBlock Text="{Binding GridInfo, StringFormat='Размер: {0}'}"/>
                <TextBlock Text="{Binding GridInfoDx, StringFormat='Шаг dx: {0:F3}'}"/>
                <TextBlock Text="{Binding GridInfoDy, StringFormat='Шаг dy: {0:F3}'}"/>
                <TextBlock Text="{Binding GridInfoDt, StringFormat='Шаг dt: {0:E3} с'}"/>
                <TextBlock Text="{Binding MaxStableDt, StringFormat='Макс. устойчивый dt: {0:E3} с'}"/>
                <TextBlock Text="{Binding GridInfoLength, StringFormat='Область Lx×Ly: {0:F2}×{1:F2} м'}" />
            </StackPanel>
        </GroupBox>

        <!-- Правая панель: настройки моделирования -->
        <GroupBox Header="Настройки моделирования" Grid.Column="2" Margin="5">
            <StackPanel>
                <TextBlock Text="Время моделирования (с):" Margin="0,5,0,2"/>
                <TextBox Text="{Binding SimulationTime, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding RecommendedTime, StringFormat='Рекомендуемое: {0:E3} с'}" 
                           Foreground="Gray" FontStyle="Italic" Margin="0,2,0,5"/>
                <TextBlock Text="{Binding TimeStepsInfo, StringFormat='Шагов: {0:N0}'}"/>

                <TextBlock Text="Задержка отрисовки (мс):" Margin="0,10,0,2"/>
                <TextBox Text="{Binding SleepDelayMs}"/>

                <Button Content="Рассчитать по умолчанию" Margin="0,15,0,5" 
                        Command="{Binding CalculateDefaultCommand}" Padding="10,3"/>
            </StackPanel>
        </GroupBox>

        <!-- Кнопки OK / Cancel -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Запустить" IsDefault="True" Command="{Binding OkCommand}" Width="80" Height="25" Margin="5"/>
            <Button Content="Отмена" IsCancel="True" Width="80" Height="25"/>
        </StackPanel>
    </Grid>
</Window>
